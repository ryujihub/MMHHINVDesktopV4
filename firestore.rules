rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Users collection - only admins can read/write user data
    match /users/{userId} {
      allow read, write: if isAdmin();
    }

    // Inventory (products) collection - authenticated users can read, only admins can write
    match /inventory/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Categories collection - authenticated users can read, only admins can write
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Orders collection - authenticated users can read/write
    match /orders/{orderId} {
      allow read, write: if isAuthenticated();
    }

    // Activity collection - only admins can read/write
    match /activity/{activityId} {
      allow read, write: if isAdmin();
    }

    // Settings collection - only admins can read/write
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Audit logs collection - only admins can read/write
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
